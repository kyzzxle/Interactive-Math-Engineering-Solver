  <meta name="theme-color" content="#f2f4ec" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#161f1b" media="(prefers-color-scheme: dark)">
  <meta name="color-scheme" content="light dark">
  {{adsenseMeta}}
  <script>(function(){var t=null;try{t=localStorage.getItem("theme")}catch(e){}var d=t?t==="dark":window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches;if(d)document.documentElement.classList.add("dark")})();</script>
