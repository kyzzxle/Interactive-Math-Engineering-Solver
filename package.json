{
  "name": "interactive-math-engineering-solver-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Static educational calculator website (GitHub Pages compatible).",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "css": "npx --yes tailwindcss@3.4.16 -c tailwind.config.cjs -i assets/css/tailwind.src.css -o assets/css/tailwind.css --minify",
    "check": "node tools/build.mjs --check",
    "serve": "node tools/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\" && node tools/check-links.mjs",
    "og": "node tools/og-images.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
